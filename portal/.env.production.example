# Copy to .env.production and fill in real production values.
# The Windows service sets APP_ENV=production automatically.

APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your.production.domain,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your.production.domain
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/ssms_prod
LOW_STOCK_THRESHOLD=20
BRANCH_OFFLINE_HOURS=24
POS_SQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=PROD_SQL_HOST;Database=pricing;Trusted_Connection=yes;TrustServerCertificate=yes;

# Waitress (used by run_waitress.py / Windows service)
WAITRESS_HOST=0.0.0.0
WAITRESS_PORT=2023
WAITRESS_THREADS=6
